PORT=5000
# Server address only. Each business gets its own database on this server.
MONGO_URI=mongodb://127.0.0.1:27017
# Shared database that only lists the registered businesses
PLATFORM_DB=farmlink_platform
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=12h
# Encrypts each business's M-Pesa consumer secret and passkey in its database. Keep it safe: changing it makes saved secrets unreadable.
SETTINGS_ENCRYPTION_KEY=change-this-to-another-long-random-string
CLIENT_ORIGIN=http://localhost:5173
# Public HTTPS address of this server (for example an ngrok URL) so Safaricom can send payment results to every business.
# Leave blank during local development: the server then asks Safaricom for the result instead.
MPESA_CALLBACK_BASE_URL=
